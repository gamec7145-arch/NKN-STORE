<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NKN STORE — Banner Admin</title>
  <meta name="theme-color" content="#071225">
  <style>
    :root{color-scheme:dark;--bg:#071225;--panel:#0d1b31;--line:#223650;--blue:#278cff;--text:#eef5ff;--muted:#9fb1ca}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}
    main{width:min(920px,100%);margin:auto;padding:22px 16px 48px}.brand{font-weight:800;font-size:1.35rem}.brand span{color:var(--blue)}
    h1{font-size:1.65rem;margin:22px 0 6px}p,.muted{color:var(--muted)}.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;margin-top:18px}
    label{display:block;font-weight:650;margin:12px 0 6px}input,select,button{font:inherit}input,select{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:#09162a;color:var(--text)}
    button{border:0;border-radius:10px;padding:12px 16px;background:var(--blue);color:white;font-weight:750;cursor:pointer;margin-top:14px}button.secondary{background:#1b2b42;border:1px solid var(--line)}button.danger{background:#a72e43}
    .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.hidden{display:none!important}.status{padding:10px 12px;border-radius:10px;background:#09162a;margin-top:12px;white-space:pre-wrap}
    .banner{display:grid;grid-template-columns:112px 1fr;gap:14px;align-items:center;border-top:1px solid var(--line);padding:14px 0}
    .banner img{width:112px;aspect-ratio:16/9;object-fit:cover;border-radius:9px;background:#030a14}.banner h3{margin:0 0 4px;font-size:1rem}.banner small{color:var(--muted)}
    .actions{display:flex;gap:8px;flex-wrap:wrap}.actions button{margin-top:8px;padding:8px 12px}.preview{width:100%;max-height:260px;object-fit:contain;border-radius:10px;margin-top:12px;background:#050d1a}
    @media(max-width:560px){.row{grid-template-columns:1fr}.panel{padding:14px}.banner{grid-template-columns:90px 1fr}.banner img{width:90px}}
  </style>
</head>
<body>
<main>
  <div class="brand">NKN <span>STORE</span> <small class="muted">/ Banner Admin</small></div>
  <h1>Banner Management</h1>
  <p>Upload and manage separate banners for Games Home and Apps. Use a wide landscape image for best results.</p>

  <section id="loginPanel" class="panel">
    <h2>Admin sign in</h2>
    <p>Only the account approved in Supabase can manage banners.</p>
    <form id="loginForm">
      <label for="email">Admin email</label><input id="email" type="email" autocomplete="username" required>
      <label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required>
      <button type="submit">Sign in</button>
    </form>
  </section>

  <section id="appPanel" class="hidden">
    <div class="panel">
      <div class="row">
        <div><label for="section">Show banner on</label><select id="section"><option value="games">Games Home</option><option value="apps">Apps Page</option></select></div>
        <div><label for="sortOrder">Display order</label><input id="sortOrder" type="number" value="0" min="0" step="1"></div>
      </div>
      <label for="imageFile">Choose image from phone</label><input id="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required>
      <label for="altText">Image description (optional)</label><input id="altText" type="text" maxlength="120" placeholder="e.g. New games this week">
      <img id="preview" class="preview hidden" alt="Selected image preview">
      <button id="uploadButton" type="button">Upload & Add Banner</button>
      <button id="signOutButton" class="secondary" type="button">Sign out</button>
      <div id="status" class="status" role="status">Signed out.</div>
    </div>
    <div class="panel">
      <h2>Existing banners</h2>
      <p>Use the arrows to reorder banners. Inactive banners won't appear on the site.</p>
      <div id="bannerList"></div>
    </div>
  </section>
</main>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="admin.js"></script>
</body>
</html>
